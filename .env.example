# Copy to .env, chmod 600 .env; blank values are requested on first use.
# Values are literal; no export, variable expansion, escapes or inline comments.
SITE_USER=
PROJECT_NAME=
GIT_PROVIDER=
REPO_URL=
PHP_VERSION=8.3
# auto: current APT sources first, then Ondrej PPA for this exact Ubuntu release.
PHP_SOURCE=auto
# SSH port already configured on the server. The scripts do not change sshd.
SSH_PORT=
DOMAIN=
INCLUDE_WWW=false
CERTBOT_EMAIL=
DB_NAME=
DB_USER=
DB_PORT=5432
INSTALL_COMPOSER_DEPS=false
NON_INTERACTIVE=false
